# Backups y temporales
*.bak
*.bak.*
*.bak[0-9]*
*.bak-*
*.tar.gz
*.zip
*~
__pycache__/
*.log

# Estado generado en runtime (no es configuración)
.config/quickshell/ii-backups/
.config/illogical-impulse/installed_listfile
.config/illogical-impulse/installed_true
.config/gtk-3.0/bookmarks

# Nunca subir credenciales
*.pem
*.key
.env
**/secrets*

# el shim se compila en cada equipo
local/lib/qs-webengine-shim/*.so

# estado de sesiones de Claude Code (worktrees, historial): nunca es config
# compartible y puede contener copias enteras del repo
.claude/
